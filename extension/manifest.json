{
  "manifest_version": 3,
  "name": "MSP工单记录",
  "version": "1.0.0",
  "action": {
    "default_title": "提交问题到飞书"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
